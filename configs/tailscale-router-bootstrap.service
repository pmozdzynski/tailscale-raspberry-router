[Unit]
Description=Tailscale Router Bootstrap Wizard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tailscale-raspberry-router
ExecStart=/opt/tailscale-raspberry-router/tailscale-router-bootstrap
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
